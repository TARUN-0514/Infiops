# Copy to .env and fill in. Never commit .env.
NEXUS_ENV=development
NEXUS_LOG_LEVEL=INFO

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
NEXUS_JWT_SECRET=
# Generate with: python -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"
NEXUS_ENCRYPTION_KEY=

NEXUS_DATABASE_URL=postgresql+asyncpg://nexus:nexus@localhost:5432/nexus
NEXUS_REDIS_URL=redis://localhost:6379/0
NEXUS_CORS_ORIGINS=["http://localhost:3000"]
# Set to false only for local http development. Keep true in production (HTTPS).
NEXUS_COOKIE_SECURE=false
NEXUS_ACCESS_TOKEN_MINUTES=15
NEXUS_REFRESH_TOKEN_DAYS=30

POSTGRES_PASSWORD=nexus
MINIO_ROOT_USER=nexus
MINIO_ROOT_PASSWORD=nexus-dev-password

# --- AI (local-first) -----------------------------------------------------------
# Everything runs on your PC by default, at no cost. Point NEXUS at Ollama or LM Studio.
#   Ollama:    http://localhost:11434/v1   (model names like qwen3:14b)
#   LM Studio: http://localhost:1234/v1    (use the model id LM Studio shows)
NEXUS_LOCAL_BASE_URL=http://localhost:11434/v1
NEXUS_LOCAL_MODEL=qwen3:14b
# Optional: a different model for long plans, and a smaller one for background extraction.
NEXUS_LOCAL_MODEL_PLAN=
NEXUS_LOCAL_MODEL_FAST=
# Memory search embeddings (Ollama: `ollama pull bge-m3`). Use "none" for keyword search only.
NEXUS_EMBEDDING_PROVIDER=ollama
NEXUS_OLLAMA_URL=http://localhost:11434
# When the API runs in Docker, it reaches the model server on your PC through these:
NEXUS_LOCAL_BASE_URL_DOCKER=http://host.docker.internal:11434/v1
NEXUS_OLLAMA_URL_DOCKER=http://host.docker.internal:11434

# Optional cloud for very hard tasks. Off by default; you choose it per message.
NEXUS_CLOUD_ENABLED=false
NEXUS_ANTHROPIC_API_KEY=
NEXUS_CLOUD_DAILY_TOKEN_BUDGET=300000

# Optional: a local vision model to read images in the knowledge base (e.g. qwen2.5vl:7b).
NEXUS_LOCAL_MODEL_VISION=

# --- Google (email and calendar) ----------------------------------------------------
# Create an OAuth client in Google Cloud (see README). Leave empty to skip Google.
NEXUS_GOOGLE_CLIENT_ID=
NEXUS_GOOGLE_CLIENT_SECRET=
# The address you open NEXUS at. Google redirects to {this}/api/v1/integrations/google/callback.
NEXUS_PUBLIC_WEB_URL=http://localhost:3000
NEXUS_SYNC_INTERVAL_MINUTES=10
NEXUS_EMAIL_SYNC_DAYS=14

# --- Notifications ---------------------------------------------------------------------
# Web Push keys. Leave empty and NEXUS generates a pair on first use and keeps it in its data folder.
NEXUS_VAPID_PUBLIC_KEY=
NEXUS_VAPID_PRIVATE_KEY=
NEXUS_VAPID_SUBJECT=mailto:owner@localhost
NEXUS_BRIEFING_DEFAULT_TIME=07:30

# --- Voice (local) ---------------------------------------------------------------------
# The "voice" service in docker compose runs Whisper and Piper. Outside Docker:
#   cd services/voice && uv sync --extra engines && uv run nexus-voice
NEXUS_STT_URL=http://localhost:8880/v1/audio/transcriptions
NEXUS_TTS_URL=http://localhost:8880/v1/audio/speech
# For whisper.cpp with Vulkan on your PC, use http://host.docker.internal:8178/inference here:
NEXUS_STT_URL_DOCKER=
NEXUS_TTS_URL_DOCKER=
NEXUS_STT_LANGUAGE=en
NEXUS_VOICE_STT_MODEL=base.en
NEXUS_TTS_VOICE=en_US-lessac-medium

# --- Phase 4: web search, research and GitHub ---------------------------------------
# Private search server (docker compose up -d search). No API key needed.
NEXUS_SEARXNG_URL=http://localhost:8888
NEXUS_SEARXNG_URL_DOCKER=
SEARXNG_SECRET=
# Largest web page NEXUS downloads, in KB.
NEXUS_WEB_FETCH_MAX_KB=1500
# GitHub, read-only. Fine-grained token with read access to Contents, Pull requests and
# Issues for the listed repositories only. Leave empty to keep GitHub off.
NEXUS_GITHUB_TOKEN=
# JSON list of owner/name, e.g. ["TARUN-0514/Infiops"]
NEXUS_GITHUB_REPOS=[]
